{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetMeta",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "domain": {
      "enum": [
        "ecommerce",
        "fintech",
        "logistica"
      ]
    },
    "kind": {
      "enum": [
        "golden",
        "bug-sembrado",
        "trampa-esquema",
        "no-arranca"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "domain",
    "kind",
    "description"
  ],
  "additionalProperties": false
}
