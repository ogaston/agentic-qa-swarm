{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/events/v1/deploy.schema.json",
  "title": "Evento deploy.done | deploy.failed",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "deploy.done",
        "deploy.failed"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "warm_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "build-from-repo",
                "published-image"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "warm_id",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "trace_id",
    "data"
  ],
  "additionalProperties": false
}
