{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/events/v1/reset.verified.schema.json",
  "title": "Evento reset.verified",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "reset.verified"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "warm_id": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "ok": {
                "const": true
              }
            },
            "required": [
              "name",
              "ok"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "run_id",
        "warm_id",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "trace_id",
    "data"
  ],
  "additionalProperties": false
}
