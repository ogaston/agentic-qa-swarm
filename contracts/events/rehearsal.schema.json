{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/events/v1/rehearsal.schema.json",
  "title": "Evento rehearsal.passed | rehearsal.failed",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "rehearsal.passed",
        "rehearsal.failed"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "run_id",
        "flow_id",
        "passed",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "trace_id",
    "data"
  ],
  "additionalProperties": false
}
