{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/events/v1/teardown.verified.schema.json",
  "title": "Evento teardown.verified",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "teardown.verified"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "warm_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "rebuild",
            "teardown"
          ]
        },
        "verified": {
          "const": true
        }
      },
      "required": [
        "warm_id",
        "mode",
        "verified"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "trace_id",
    "data"
  ],
  "additionalProperties": false
}
