{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/events/v1/notify.created.schema.json",
  "title": "Evento notify.created",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "notify.created"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "notification_id": {
          "type": "string",
          "minLength": 1
        },
        "github_event": {
          "enum": [
            "commit",
            "pull_request",
            "tag"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "build-from-repo",
                "published-image"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "notification_id",
        "github_event",
        "repo",
        "sha",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "trace_id",
    "data"
  ],
  "additionalProperties": false
}
