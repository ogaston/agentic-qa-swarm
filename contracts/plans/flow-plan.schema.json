{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/plans/v1/flow-plan.schema.json",
  "title": "FlowPlan",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "expect_status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                }
              },
              "required": [
                "method",
                "path",
                "expect_status"
              ],
              "additionalProperties": false
            }
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "flow_id",
          "name",
          "steps",
          "invariant"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "workflow",
    "flows"
  ],
  "additionalProperties": false
}
