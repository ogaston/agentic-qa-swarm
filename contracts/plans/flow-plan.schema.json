{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/plans/v1/flow-plan.schema.json",
  "title": "FlowPlan",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "pattern": "^[a-z0-9]([-a-z0-9]{0,33}[a-z0-9])?$",
            "description": "Etiqueta DNS: minusculas, digitos y guiones; 1 a 35 caracteres. Es parte del nombre del Job runner (runner-<run_id>-<flow_id> <= 63)."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "expect_status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "body": {
                  "type": "object",
                  "description": "Cuerpo JSON opcional del paso (solo objetos). Sin body no se envia cuerpo ni Content-Type."
                }
              },
              "required": [
                "method",
                "path",
                "expect_status"
              ],
              "additionalProperties": false
            }
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "invariant_probe": {
            "type": "boolean",
            "default": false,
            "description": "true si el flujo sondea una invariante (su fallo seria un hallazgo). El ensayo solo exige que sea ejecutable; los runners siempre exigen expect_status."
          }
        },
        "required": [
          "flow_id",
          "name",
          "steps",
          "invariant"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "workflow",
    "flows"
  ],
  "additionalProperties": false
}
