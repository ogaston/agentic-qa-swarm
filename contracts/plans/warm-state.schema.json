{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/plans/v1/warm-state.schema.json",
  "title": "WarmState",
  "type": "object",
  "properties": {
    "warm_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ready",
        "dirty",
        "cuarentena",
        "idle-escalado",
        "provisioning",
        "deleting"
      ]
    },
    "reset_verified": {
      "type": "boolean"
    },
    "baseline_version": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    }
  },
  "required": [
    "warm_id",
    "state",
    "reset_verified",
    "baseline_version"
  ],
  "additionalProperties": false
}
