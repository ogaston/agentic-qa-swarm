{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa-swarm.example/contracts/plans/v1/surface-artifact.schema.json",
  "title": "SurfaceArtifact",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "enum": [
        "openapi",
        "probe"
      ]
    }
  },
  "required": [
    "run_id",
    "base_url",
    "endpoints",
    "source"
  ],
  "additionalProperties": false
}
